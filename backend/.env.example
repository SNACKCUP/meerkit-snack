APP_ENV=local
DATABASE_URL=postgresql+psycopg://starter:starter@localhost:5432/starter
# 32자 이상 임의 문자열. 운영에서는 반드시 바꾸세요 (예: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-bytes-or-more
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# 배포(https)에서는 true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# 로컬 테스트용 관리자 계정 (로컬 전용! 운영에서 쓰지 마세요)
# 만들기: uv run python -m app.users.seed
SEED_ADMIN_EMAIL=admin@meerkit.local
SEED_ADMIN_PASSWORD=meerkit-local-admin
SEED_ADMIN_NAME=관리자
