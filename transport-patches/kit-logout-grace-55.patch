 backend/app/auth/repository.py           |  7 ++++++-
 backend/app/auth/service.py              | 13 ++++++++++---
 backend/tests/kit/test_refresh_revoke.py | 24 ++++++++++++++++++++++++
 3 files changed, 40 insertions(+), 4 deletions(-)

diff --git a/backend/app/auth/repository.py b/backend/app/auth/repository.py
index b904c6f..ca149b9 100644
--- a/backend/app/auth/repository.py
+++ b/backend/app/auth/repository.py
@@ -116,8 +116,13 @@ def get_refresh_token_by_hash(db: Session, token_hash: str) -> RefreshToken | No
     return db.scalar(select(RefreshToken).where(RefreshToken.token_hash == token_hash).with_for_update())
 
 
+def get_refresh_token(db: Session, token_id: int) -> RefreshToken | None:
+    """id로 발급 기록 1건 (회전으로 바뀐 새 토큰이 아직 살아 있는지 볼 때)"""
+    return db.get(RefreshToken, token_id)
+
+
 def revoke_refresh_family(db: Session, family_id: str, now: datetime) -> int:
-    """한 로그인에서 이어진 토큰을 모두 폐기 (이미 바뀐 토큰이 다시 왔을 때)"""
+    """한 로그인에서 이어진 토큰을 모두 폐기 (로그아웃, 이미 바뀐 토큰이 다시 왔을 때)"""
     result = db.execute(
         update(RefreshToken)
         .where(RefreshToken.family_id == family_id, RefreshToken.revoked_at.is_(None))
diff --git a/backend/app/auth/service.py b/backend/app/auth/service.py
index d437d49..2c96acc 100644
--- a/backend/app/auth/service.py
+++ b/backend/app/auth/service.py
@@ -154,6 +154,10 @@ def refresh_tokens(db: Session, token: str) -> tuple[str, str | None] | None:
         if row.replaced_by_id is None:  # 로그아웃·전체 폐기한 토큰
             return None
         if now - row.revoked_at <= timedelta(seconds=REFRESH_REUSE_GRACE_SECONDS):
+            # 유예는 바뀐 새 토큰이 아직 살아 있을 때만 줍니다. 그 사이 로그아웃했으면 옛 쿠키로 다시 들어오지 못합니다
+            replacement = auth_repository.get_refresh_token(db, row.replaced_by_id)
+            if replacement is None or replacement.revoked_at is not None:
+                return None
             return create_token(user.id, "access"), None
         revoked = auth_repository.revoke_refresh_family(db, row.family_id, now)
         db.commit()
@@ -167,10 +171,13 @@ def refresh_tokens(db: Session, token: str) -> tuple[str, str | None] | None:
 
 
 def revoke_refresh_token(db: Session, token: str) -> None:
-    """로그아웃: 이 기기의 리프레시 토큰만 폐기 (다른 기기는 그대로)"""
+    """로그아웃: 이 기기(같은 로그인 family)의 리프레시 토큰을 모두 폐기 (다른 기기는 그대로).
+
+    방금 회전돼 옛 토큰이 된 쿠키로 로그아웃해도 새 토큰까지 함께 막히도록 family 단위로 폐기합니다.
+    """
     row = auth_repository.get_refresh_token_by_hash(db, hash_secret(token))
-    if row is not None and row.revoked_at is None:
-        row.revoked_at = _now()
+    if row is not None:
+        auth_repository.revoke_refresh_family(db, row.family_id, _now())
         db.commit()
 
 
diff --git a/backend/tests/kit/test_refresh_revoke.py b/backend/tests/kit/test_refresh_revoke.py
index f44bc26..aae6b64 100644
--- a/backend/tests/kit/test_refresh_revoke.py
+++ b/backend/tests/kit/test_refresh_revoke.py
@@ -83,6 +83,30 @@ def test_logout_revokes_only_this_device(client, make_user):  # client: DB 를 
         assert _refresh_with(phone, phone_token).status_code == 200  # 휴대폰은 그대로
 
 
+def test_logout_closes_reuse_grace_for_old_cookie(client, make_user):
+    # 갱신으로 바뀐 옛 쿠키는 다른 탭 때문에 10초 유예가 있지만, 그 사이 로그아웃했으면 다시 들어오지 못함
+    make_user("user01")
+    old = _login(client)
+    new = _refresh_with(client, old).cookies[COOKIE]
+    client.cookies.clear()
+    client.cookies.set(COOKIE, new, path="/api/auth")
+    assert client.post("/api/auth/logout").status_code == 204
+    assert _refresh_with(client, old).status_code == 401  # 유예 시간 안이어도 거절
+    assert _refresh_with(client, new).status_code == 401
+
+
+def test_logout_with_rotated_cookie_also_revokes_new_token(client, make_user):
+    # 옛 쿠키로 로그아웃해도 같은 로그인의 새 토큰까지 함께 폐기
+    make_user("user01")
+    old = _login(client)
+    new = _refresh_with(client, old).cookies[COOKIE]
+    client.cookies.clear()
+    client.cookies.set(COOKIE, old, path="/api/auth")
+    assert client.post("/api/auth/logout").status_code == 204
+    assert _refresh_with(client, new).status_code == 401
+    assert _refresh_with(client, old).status_code == 401
+
+
 def test_password_change_logs_out_other_devices(client, make_user):
     make_user("user01")
     with TestClient(app) as other, TestClient(app) as me:
