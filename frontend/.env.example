# 브라우저에서 호출할 API 기본 경로 (기본값 /api → next.config.ts 프록시가 백엔드로 전달)
NEXT_PUBLIC_API_BASE_URL=/api
# /api 프록시가 전달할 백엔드 주소
API_PROXY_TARGET=http://localhost:8000
# 초기 화면의 "사용 설명서" 링크 주소
NEXT_PUBLIC_DOCS_URL=https://github.com/sensibly00-glitch/meerkit#readme
# /ui (UI 모음) 페이지 노출 여부. 운영 배포에서는 false
NEXT_PUBLIC_SHOW_UI_PAGE=true
