# 브라우저에서 호출할 API 기본 경로 (기본값 /api → next.config.ts 프록시가 백엔드로 전달)
NEXT_PUBLIC_API_BASE_URL=/api
# /api 프록시가 전달할 백엔드 주소
API_PROXY_TARGET=http://localhost:8000
# 웰컴 페이지 Docs 링크 주소 (문서를 따로 배포했다면 그 주소). 비우면 이 앱의 /docs
NEXT_PUBLIC_DOCS_URL=
# GitHub 저장소 주소
NEXT_PUBLIC_GITHUB_URL=https://github.com/sensibly00-glitch/meerkit
# 이 앱에서 /docs 라우트를 열지 여부. 문서를 별도 사이트로 배포하면 앱은 false
NEXT_PUBLIC_SHOW_DOCS_PAGE=true
